@inject IStringLocalizerFactory LocalizerFactory
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization

<div class="relative p-6 sm:p-8 bg-white dark:bg-gray-700 rounded-lg sm:shadow-xl max-w-md w-full mx-auto">
    <div class="text-center">
        <h2 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">@Localizer["ErrorTitle"]</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">@Localizer["ErrorDescription"]</p>
        <button type="button" @onclick="Reload" class="mt-4 px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700">
            @Localizer["RetryButton"]
        </button>
    </div>
</div>

@code {
    private IStringLocalizer Localizer => LocalizerFactory.Create("Pages.Main.Sync.StatusMessages.ErrorVaultLoad", "AliasVault.Client");

    /// <summary>
    /// Reloads the app so the vault fetch is retried. This failure is usually transient,
    /// e.g. an expired token that the next attempt refreshes, so a retry is the fix
    /// rather than a support request.
    /// </summary>
    private void Reload()
    {
        NavigationManager.Refresh(forceReload: true);
    }
}
