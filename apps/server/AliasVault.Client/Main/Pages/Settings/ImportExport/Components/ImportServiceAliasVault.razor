@inject ILogger<ImportServiceAliasVault> Logger
@inject NavigationManager NavigationManager
@inject GlobalNotificationService GlobalNotificationService
@inject IStringLocalizerFactory LocalizerFactory
@inject AliasVault.Client.Services.Crypto.AvexCryptoService AvexCrypto
@using AliasVault.ImportExport.Models
@using AliasVault.ImportExport.Exceptions
@using AliasVault.ImportExport.Importers
@using AliasVault.ImportExport
@using Microsoft.Extensions.Localization
@using System.Text

<ImportServiceCard
    @ref="importServiceCard"
    ServiceName="AliasVault"
    Description="@Localizer["AliasVaultDescription"]"
    LogoUrl="img/logo.svg"
    AcceptedFileExtensions="AcceptedExtensions"
    PasswordProtectedFileExtensions="PasswordProtectedExtensions"
    ProcessFileCallback="ProcessFile"
    DecryptFileCallback="DecryptFile">
    <p class="text-gray-700 dark:text-gray-300 mb-4">@Localizer["AliasVaultInstructionsPart1"]</p>
</ImportServiceCard>

@code {
    private IStringLocalizer Localizer => LocalizerFactory.Create("Components.Main.Settings.ImportExport.ImportServices", "AliasVault.Client");
    private static readonly string[] AcceptedExtensions = new[] { ".avex", ".avux", ".csv" };
    private static readonly string[] PasswordProtectedExtensions = new[] { ".avex" };
    private ImportServiceCard? importServiceCard;

    /// <summary>
    /// Decrypts an encrypted .avex file and parses the resulting .avux payload.
    /// This lives here rather than in the shared card so that the card stays
    /// format agnostic and can serve .kdbx databases as well.
    /// </summary>
    /// <param name="fileBytes">The encrypted file bytes.</param>
    /// <param name="filename">The original filename.</param>
    /// <param name="password">The password entered by the user.</param>
    /// <returns>The parsed import result.</returns>
    private async Task<ImportFileResult> DecryptFile(byte[] fileBytes, string filename, string password)
    {
        byte[] avuxBytes;
        try
        {
            avuxBytes = await AvexCrypto.DecryptAvexAsync(fileBytes, password);
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("password may be incorrect"))
        {
            throw new InvalidImportPasswordException(ex.Message, ex);
        }

        return await VaultImportService.ImportFromAvuxAsync(avuxBytes);
    }

    /// <summary>
    /// Processes files with auto-detection based on file extension.
    /// Returns a list of ImportedCredential objects with logos embedded in FaviconBytes.
    /// </summary>
    /// <param name="filename">The name of the uploaded file.</param>
    /// <param name="fileBytes">The file content as bytes.</param>
    /// <returns>A list of ImportedCredential objects.</returns>
    private async Task<ImportFileResult> ProcessFile(string filename, byte[] fileBytes)
    {
        try
        {
            // Detect file format based on extension
            if (filename.EndsWith(".avux", StringComparison.OrdinalIgnoreCase))
            {
                // Process as binary .avux file
                return await VaultImportService.ImportFromAvuxAsync(fileBytes);
            }
            else if (filename.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                // Process as text CSV file
                var fileContents = Encoding.UTF8.GetString(fileBytes);
                return await ItemCsvService.ImportItemsFromCsv(fileContents);
            }
            else
            {
                throw new InvalidOperationException($"Unsupported file format: {filename}. Expected .csv or .avux");
            }
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException($"Failed to import file '{filename}': {ex.Message}", ex);
        }
    }
}