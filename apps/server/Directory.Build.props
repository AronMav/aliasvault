<Project>

  <!--
    Central build settings inherited by every project under apps/server.

    NuGet package vulnerability audit warnings (NU1901-NU1904) should stay
    visible but must not fail the build. This keeps interactive builds (e.g.
    building an older version whose dependencies now have advisories) working
    while still surfacing the notice. CI can re-promote these to errors if desired.
  -->
  <PropertyGroup>
    <WarningsNotAsErrors Condition="'$(SecurityAudit)' != 'true'">$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!--
      The security pins below are transitive-only for several projects, which
      trips the NU1510 prune warning; restore promotes warnings in this tree,
      so the pin pair would fail those projects' restore. Remove together with
      the pins once the direct references move past 10.0.13.
    -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <!--
    Pin transitive System.Security.* packages above the vulnerable 10.0.12
    line (October 2026 advisories: GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83,
    GHSA-7hqp-7c5m-4vq6, GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). They arrive
    through the ASP.NET/Identity reference graph, and the security audit in CI
    treats NU1903 as an error, so every project resolves the patched 10.0.13.
    SuppressPruneWarning keeps NU1510 silent in projects that pull these only
    transitively. Drop these entries whenever the direct references move past
    10.0.13.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
